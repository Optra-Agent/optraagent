# Required for production. Local development uses a persistent PGlite directory when unset.
DATABASE_URL=
PGLITE_DATA_DIR=.local/optra-db
APP_BASE_URL=http://localhost:3000

# Required only when configuring an external hourly scheduler for the same-repository worker routes.
CRON_SECRET=
MARKET_HISTORY_SYMBOLS=AAPL

# Safety invariants. Keep real-money paths disabled for this MVP.
LIVE_TRADING_ENABLED=false
V4_CLAIM_LEVEL=L0
