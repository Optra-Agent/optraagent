# Required for production. Local development uses a persistent PGlite directory when unset.
DATABASE_URL=
PGLITE_DATA_DIR=.local/optra-db
APP_BASE_URL=http://localhost:3000

# Required in staging/production when the external host scheduler invokes paper evaluations every 15 minutes.
# Generate a unique value of at least 32 characters; never expose it to the browser.
CRON_SECRET=
# Used only by the separate optional market-snapshot collector; paper evaluations read Crius history per running agent.
MARKET_HISTORY_SYMBOLS=AAPL

# Safety invariants. Keep real-money paths disabled for this MVP.
LIVE_TRADING_ENABLED=false
V4_CLAIM_LEVEL=L0
