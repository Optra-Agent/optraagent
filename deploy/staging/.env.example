# Copy to the root-owned staging .env. Never commit actual credentials.
# The passwords below must be URL-safe hexadecimal values (openssl rand -hex 32).
APP_BASE_URL=https://replace-with-owner-approved-staging-origin
OPTRA_PROXY_NETWORK=replace-with-live-verified-proxy-network
OPTRA_STAGING_DB_ADMIN_PASSWORD=__SET_LOCALLY__
OPTRA_STAGING_APP_PASSWORD=replace-with-a-different-unique-64-character-hex-secret
CRON_SECRET=replace-with-a-different-unique-64-character-hex-secret

# Supply OPTRA_IMAGE at deployment time. This placeholder is used only by Compose config validation.
OPTRA_IMAGE=ghcr.io/optra-agent/optraagent:sha-0000000000000000000000000000000000000000
