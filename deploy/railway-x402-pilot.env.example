# Railway Production Environment Template — Wave A x402 Mainnet Pilot
# Keep real-money paths disabled until explicit owner approval and pilot funding.

LIVE_TRADING_ENABLED=false
V4_CLAIM_LEVEL=L0

# Default safe mode: PAPER_REHEARSAL (no on-chain USDG transfers).
# Change to `live` ONLY when explicitly authorized for the single 0.02 USDG pilot.
X402_FACILITATOR_MODE=paper
X402_FACILITATOR_URL=https://x402.aeron.sh

# Pilot isolation: ONLY this agent UUID may spend in live mode; all other agents & cron ticks are blocked.
X402_PILOT_AGENT_ID=
X402_PILOT_MAX_PAYMENTS=1

# Recipient & isolated signer (set X402_SIGNER_PRIVATE_KEY directly in Railway secret variables, never commit)
X402_TREASURY_ADDRESS=0x23439a41eDC01D58d3Aaa0C75E9dFEE0C0196848
# X402_SIGNER_PRIVATE_KEY=<from .env.pilot.local>
